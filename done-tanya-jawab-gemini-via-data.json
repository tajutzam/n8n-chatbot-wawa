      "id": "b2000001-0000-4000-8000-000000000013",
      "name": "Hasil Upload",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [1460, 80],
      "webhookId": "hasil-upload-knowledge"
    },
    {
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "none",
        "initialMessages": "Halo! 👋 Saya menjawab berdasarkan knowledge yang sudah diunggah lewat form Upload Knowledge. Silakan tanya apa saja.",
        "options": {
          "title": "Chatbot Dokumen",
          "subtitle": "Tanya jawab berdasarkan knowledge tersimpan"
        }
      },
      "id": "b2000001-0000-4000-8000-000000000014",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 700],
      "webhookId": "chatbot-dokumen-gemini"
    },
    {
      "parameters": {
        "jsCode": "const MAX_TOTAL = 800000;\nconst meta = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nconst docs = Object.values((sd.knowledge && sd.knowledge.docs) || {});\n\nlet text = '';\nlet used = 0;\nfor (const d of docs) {\n  const block = '=== DOKUMEN: ' + d.fileName + ' ===\\n' + d.text + '\\n\\n';\n  if (used + block.length > MAX_TOTAL) {\n    text += '[CATATAN: knowledge terlalu banyak, sebagian dokumen tidak dimuat]';\n    break;\n  }\n  text += block;\n  used += block.length;\n}\n\nreturn [{\n  json: {\n    sessionId: meta.sessionId,\n    chatInput: meta.chatInput,\n    fileName: docs.map(d => d.fileName).join(', '),\n    documentText: text\n  }\n}];"
      },
      "id": "b2000001-0000-4000-8000-000000000015",
      "name": "Muat Knowledge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 700]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "=Kamu adalah asisten yang menjawab pertanyaan berdasarkan knowledge (dokumen/Excel) yang sudah tersimpan.\n\nATURAN:\n- Jawab dengan bahasa yang dipakai user.\n- Gunakan hanya informasi dari knowledge di bawah. Jika jawabannya tidak ada, katakan tidak ditemukan.\n- Untuk data tabel/Excel, hitung dengan teliti (jumlah, rata-rata, filter, dll) dan sebutkan kolom atau nomor data sumbernya.\n- Jika knowledge masih kosong, minta user mengunggah dokumen lewat form Upload Knowledge terlebih dahulu.\n\nDAFTAR DOKUMEN: {{ $json.fileName || '(belum ada)' }}\n\nISI KNOWLEDGE:\n{{ $json.documentText || '(belum ada knowledge)' }}"
        }
      },
      "id": "b2000001-0000-4000-8000-000000000016",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [500, 700]
