    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg",
              "name": "message",
              "value": "=Format file .{{ $('Siapkan File').first().json.ext }} belum didukung. Gunakan: xlsx, xls, csv, pdf, txt, md, atau json. (File Word bisa disimpan sebagai PDF dulu.)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000010",
      "name": "File Tidak Didukung",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [940, 300]
    },
    {
      "parameters": {
        "jsCode": "const MAX_CHARS_PER_DOC = 500000;\nconst meta = $('Siapkan File').first().json;\nconst items = $input.all().map(i => i.json);\nlet text = '';\n\nif (['xlsx', 'xls', 'csv'].includes(meta.ext)) {\n  const headers = [...new Set(items.flatMap(r => Object.keys(r)))];\n  const lines = ['Kolom: ' + headers.join(' | ')];\n  items.forEach((r, idx) => {\n    lines.push('Data #' + (idx + 1) + ': ' + headers.map(h => r[h] ?? '').join(' | '));\n  });\n  text = lines.join('\\n');\n} else {\n  text = items.map(r => r.text ?? r.data ?? '').join('\\n');\n}\n\nlet truncated = false;\nif (text.length > MAX_CHARS_PER_DOC) {\n  text = text.slice(0, MAX_CHARS_PER_DOC);\n  text += '\\n\\n[CATATAN: dokumen terlalu panjang, sebagian isi dipotong]';\n  truncated = true;\n}\n\nconst sd = $getWorkflowStaticData('global');\nsd.knowledge = sd.knowledge || { docs: {} };\nif (meta.mode === 'Ganti semua knowledge') sd.knowledge.docs = {};\n\nsd.knowledge.docs[meta.fileName] = {\n  fileName: meta.fileName,\n  ext: meta.ext,\n  text,\n  chars: text.length,\n  uploadedAt: new Date().toISOString()\n};\n\nconst list = Object.values(sd.knowledge.docs)\n  .map((d, i) => (i + 1) + '. ' + d.fileName + ' (' + d.chars + ' karakter)')\n  .join('\\n');\n\nconst message = '✅ \"' + meta.fileName + '\" berhasil disimpan' + (truncated ? ' (sebagian isi dipotong karena terlalu panjang)' : '') + '.\\n\\nKnowledge saat ini:\\n' + list + '\\n\\nSekarang kamu bisa mulai chat. Untuk menambah dokumen lain, kirim form ini lagi.';\n\nreturn [{ json: { message } }];"
      },
      "id": "b2000001-0000-4000-8000-000000000011",
      "name": "Simpan Knowledge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "jsCode": "const meta = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\nsd.knowledge = sd.knowledge || { docs: {} };\nlet message = '';\n\nif (meta.mode === 'Hapus semua knowledge') {\n  sd.knowledge.docs = {};\n  message = '🗑️ Semua knowledge sudah dihapus.';\n} else if (meta.mode === 'Tambah dokumen' || meta.mode === 'Ganti semua knowledge') {\n  message = '⚠️ Pilih file dokumen terlebih dahulu untuk mode \"' + meta.mode + '\".';\n} else {\n  const docs = Object.values(sd.knowledge.docs);\n  message = docs.length\n    ? 'Knowledge tersimpan:\\n' + docs.map((d, i) => (i + 1) + '. ' + d.fileName + ' (' + d.chars + ' karakter, upload ' + d.uploadedAt + ')').join('\\n')\n    : 'Belum ada knowledge tersimpan.';\n}\n\nreturn [{ json: { message } }];"
      },
      "id": "b2000001-0000-4000-8000-000000000012",
      "name": "Kelola Knowledge",
