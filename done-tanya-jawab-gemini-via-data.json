      "id": "b2000001-0000-4000-8000-000000000001",
      "name": "Form Upload Knowledge",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "upload-knowledge-dokumen"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst mode = item.json['Mode'] || 'Tambah dokumen';\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\nconst canStore = mode === 'Tambah dokumen' || mode === 'Ganti semua knowledge';\n\nconst out = { json: { mode, hasFile: keys.length > 0, action: (keys.length > 0 && canStore) ? 'store' : 'manage' } };\n\nif (keys.length > 0) {\n  const b = binary[keys[0]];\n  const fileName = b.fileName || 'dokumen';\n  const ext = (b.fileExtension || fileName.split('.').pop() || '').toLowerCase();\n  out.json.fileName = fileName;\n  out.json.ext = ext;\n  out.binary = { file: b };\n}\nreturn [out];"
      },
